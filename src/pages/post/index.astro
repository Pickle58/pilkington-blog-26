---
import Layout from "../../layouts/Layout.astro";
import { getAllPosts } from "../../sanity/lib/get-all-posts";

const posts = await getAllPosts();
---

<Layout>
	<section class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-16">
		<header class="text-center">
			<p class="text-sm uppercase tracking-[0.3em] text-slate-900">Blog</p>
			<h1 class="mt-2 text-4xl font-bold text-slate-900">Latest Posts</h1>
			<p class="mt-3 text-base text-slate-600">
				Thoughts, updates, and experiments from the Pilkington Studio.
			</p>
		</header>

		{posts.length === 0 ? (
			<p class="text-center text-slate-500">No posts published yet. Check back soon.</p>
		) : (
			<ul class="grid gap-6 sm:grid-cols-2">
				{posts.map((post) => (
					<li class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
						<a href={`/post/${post.slug?.current}`} class="block h-full">
							<p class="text-xs uppercase tracking-[0.3em] text-slate-900">
								{post.publishedAt
									? new Date(post.publishedAt).toLocaleDateString("en-US", {
											year: "numeric",
											month: "short",
											day: "numeric",
									  })
									: "Draft"}
							</p>
							<h2 class="mt-2 text-2xl font-semibold text-slate-900">{post.title ?? "Untitled Post"}</h2>
							<p class="mt-3 text-sm text-slate-600">Read more →</p>
						</a>
					</li>
				))}
			</ul>
		)}
	</section>
</Layout>

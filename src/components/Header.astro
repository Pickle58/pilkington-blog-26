---
const navLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Blog", href: "/post" },
];
---

<header class="bg-slate-900 text-white shadow-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="flex items-center gap-3 text-white">
      <span class="flex h-10 w-10 items-center justify-center rounded-full bg-amber-400 font-semibold text-slate-900">
        PB
      </span>
      <span class="text-lg font-semibold tracking-wide">Pilkington Blog</span>
    </a>

    <nav aria-label="Primary">
      <ul class="flex items-center gap-6 text-sm font-medium uppercase tracking-wide">
        {navLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="text-slate-100 transition-colors hover:text-amber-300"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

---
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-200 bg-white/80">
	<div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 py-8 text-center text-sm text-slate-600 sm:flex-row sm:justify-between sm:text-left">
		<div>
			<p class="font-semibold text-slate-900">Pilkington Enterprises</p>
			<p class="text-xs text-slate-500">&copy; {year} All rights reserved.</p>
		</div>

		<div class="flex items-center gap-4">
			<a
				href="https://github.com/Pickle58"
				target="_blank"
				rel="noreferrer"
				class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-900 transition hover:-translate-y-0.5 hover:border-amber-400"
				aria-label="GitHub"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
					<path
						fill-rule="evenodd"
						d="M12 2C6.477 2 2 6.484 2 12.012c0 4.425 2.865 8.18 6.839 9.504.5.09.682-.217.682-.483 0-.237-.009-.866-.014-1.7-2.782.605-3.37-1.342-3.37-1.342-.455-1.157-1.11-1.465-1.11-1.465-.907-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.833.091-.647.35-1.088.636-1.338-2.221-.253-4.555-1.113-4.555-4.952 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.91-1.296 2.748-1.026 2.748-1.026.546 1.378.203 2.397.1 2.65.64.7 1.027 1.595 1.027 2.688 0 3.85-2.338 4.696-4.566 4.944.36.31.68.922.68 1.859 0 1.342-.012 2.424-.012 2.753 0 .269.18.579.688.48A10.015 10.015 0 0 0 22 12.012C22 6.484 17.523 2 12 2Z"
						clip-rule="evenodd"
					/>
				</svg>
			</a>

			<a
				href="mailto:jpilkington332@gmail.com"
				class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-900 transition hover:-translate-y-0.5 hover:border-amber-400"
				aria-label="Email"
			>
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5" aria-hidden="true">
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15A2.25 2.25 0 0 1 2.25 17.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.05 1.905l-6.9 4.14a2.25 2.25 0 0 1-2.3 0l-6.9-4.14a2.25 2.25 0 0 1-1.05-1.905V6.75"
					/>
